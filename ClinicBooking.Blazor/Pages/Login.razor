@page "/login"
@* Sign-in page. After JWT is stored, BookingResume books any slot saved in sessionStorage. *@
@inject BookingResume Resume

<PageTitle>Sign in</PageTitle>

<div class="page-hero">
    <span class="page-kicker">Account</span>
    <h1>Sign in</h1>
    <p class="page-lead">Patients book visits. Clinic staff open the diary. Admin can add and edit clinics.</p>
</div>

<p class="auth-hint">Demo: <code>patient@phcis.local</code> / <code>Password123!</code> · Staff: <code>staff@phcis.local</code> · Admin: <code>admin@phcis.local</code></p> 

<SignInForm OnAuthenticated="AfterAuthAsync" />

<p class="auth-switch">
    New patient?
    <a href="@RegisterHref">Create an account</a>
</p>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string RegisterHref =>
        string.IsNullOrWhiteSpace(ReturnUrl)
            ? "/register"
            : "/register?returnUrl=" + Uri.EscapeDataString(ReturnUrl);

    /// <summary>Pending guest booking first; otherwise ReturnUrl or home.</summary>
    private Task AfterAuthAsync() => Resume.CompleteOrContinueAsync(ReturnUrl);
}
